# Payment Service Configuration
PORT=3006
MONGODB_URI=mongodb://localhost:27017/payment

# ═══════════════════════════════════════════
# SePay (DEFAULT) — Supports VCB, VIB, 30+ banks
# Register: https://my.sepay.vn/register (cá nhân OK)
# ═══════════════════════════════════════════
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_ENV=sandbox
SEPAY_SUCCESS_URL=https://yourdomain.com/payment/success
SEPAY_ERROR_URL=https://yourdomain.com/payment/error
SEPAY_CANCEL_URL=https://yourdomain.com/payment/cancel

# ═══════════════════════════════════════════
# PayOS — Limited banks (MB, OCB, BIDV, KienlongBank, ACB)
# ═══════════════════════════════════════════
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_CANCEL_URL=https://yourdomain.com/payment/cancel
PAYOS_RETURN_URL=https://yourdomain.com/payment/success

# ═══════════════════════════════════════════
# MoMo
# ═══════════════════════════════════════════
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=https://yourdomain.com/payment/success
MOMO_IPN_URL=https://api.yourdomain.com/payment/webhook/momo

# ═══════════════════════════════════════════
# ZaloPay
# ═══════════════════════════════════════════
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CALLBACK_URL=https://api.yourdomain.com/payment/webhook/zalopay

# ═══════════════════════════════════════════
# Stripe
# ═══════════════════════════════════════════
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://yourdomain.com/payment/success
STRIPE_CANCEL_URL=https://yourdomain.com/payment/cancel
