# Telegram Bot Configuration for OPC Alerts
# 1. Create bot: message @BotFather on Telegram → /newbot → name: "WinLux Ops"
# 2. Get TELEGRAM_BOT_TOKEN from BotFather
# 3. Send a message to your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your TELEGRAM_CHAT_ID

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
